rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Private profile: only the owner can read or write it.
    match /students/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public classmate card (initials unless the student opted in, no town unless opted in).
    // Any signed-in student can read cards for matching; only the owner can write theirs.
    match /classmates/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
