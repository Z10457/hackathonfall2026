rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own profile.
    // The document's id field must match the account, so nobody can write a profile for someone else.
    match /students/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.id == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.courses is list
        && request.resource.data.courses.size() <= 20;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
