rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Private profile: only the owner can read or write it.
    match /students/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public classmate card (initials unless the student opted in, no town unless opted in).
    // Any signed-in student can read cards for matching; only the owner can write theirs.
    match /classmates/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // One membership per (group, account): the document id is "<groupId>__<uid>", so joining twice
    // overwrites the same record. Any signed-in student can read memberships for member counts;
    // only the member can create or delete their own.
    match /groupMembers/{memberId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && memberId == request.resource.data.groupId + "__" + request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
