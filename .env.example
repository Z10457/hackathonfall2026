# Google Maps JavaScript API key (optional). Without it Ram Hub shows the built-in SVG route map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Accounts backend. Leave unset to use the real Firebase project (config in lib/firebase.ts, public by design).
# Set to "mock" to keep accounts in this browser only (hashed passwords), for offline demos and tests.
NEXT_PUBLIC_RAMHUB_BACKEND=
